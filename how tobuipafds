    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
    <script>
        const socket = io();
        let mySid = null;
        let activeGameType = null;
        let gameCoins = 0;
        let gameXP = 0;
        let activeKeys = {};
        let activeSocketTickEvent = null;
        let activeSocketTickHandler = null;
        let activeGameMouseHandler = null;
        let activeCustomBlobUrl = null;

        function cleanupGameRuntime() {
            if (viewportLoop !== null) {
                clearInterval(viewportLoop);
                viewportLoop = null;
            }
            window.removeEventListener('keydown', handleKeyInput);
            window.removeEventListener('keyup', handleKeyRelease);
            canvas.removeEventListener('mousemove', handleMouseCoordInput);

            if (activeGameMouseHandler) {
                canvas.removeEventListener('mousedown', activeGameMouseHandler);
                activeGameMouseHandler = null;
            }

            if (activeSocketTickEvent && activeSocketTickHandler) {
                socket.off(activeSocketTickEvent, activeSocketTickHandler);
            }
            activeSocketTickEvent = null;
            activeSocketTickHandler = null;

            if (activeCustomBlobUrl) {
                URL.revokeObjectURL(activeCustomBlobUrl);
                activeCustomBlobUrl = null;
            }

            multiData = null;
            activeKeys = {};
        }

        // Web Audio Synthesizer API
        const Sound = {
            ctx: null,
            volume: 0.5,
            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            },
            play(type) {
                this.init();
                if (this.ctx.state === 'suspended') this.ctx.resume();
                
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                
                gain.gain.setValueAtTime(this.volume * 0.2, this.ctx.currentTime);
                
                if (type === 'hit') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(150, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(10, this.ctx.currentTime + 0.15);
                    gain.gain.linearRampToValueAtTime(0, this.ctx.currentTime + 0.15);
                    osc.start(); osc.stop(this.ctx.currentTime + 0.15);
                } else if (type === 'score') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, this.ctx.currentTime); // C5
                    osc.frequency.setValueAtTime(659.25, this.ctx.currentTime + 0.08); // E5
                    gain.gain.linearRampToValueAtTime(0, this.ctx.currentTime + 0.25);
                    osc.start(); osc.stop(this.ctx.currentTime + 0.25);
                } else if (type === 'laser') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(800, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(100, this.ctx.currentTime + 0.12);
                    gain.gain.linearRampToValueAtTime(0, this.ctx.currentTime + 0.12);
                    osc.start(); osc.stop(this.ctx.currentTime + 0.12);
                } else if (type === 'gameover') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(300, this.ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(80, this.ctx.currentTime + 0.5);
                    gain.gain.linearRampToValueAtTime(0, this.ctx.currentTime + 0.5);
                    osc.start(); osc.stop(this.ctx.currentTime + 0.5);
                }
            }
        };

        function adjustSoundFx(val) {
            Sound.volume = val / 100;
        }

        // Active Sections change Handler
        function showSection(id) {
            document.querySelectorAll('.section-container').forEach(el => el.classList.add('hidden'));
            const target = document.getElementById(`section_${id}`);
            if (target) target.classList.remove('hidden');

            if (id === 'leaderboard') refreshLeaderboard();
            if (id === 'games') renderCustomGames();
        }

        function changeTheme(theme) {
            document.body.className = "flex flex-col min-h-screen";
            if (theme === 'light') {
                document.body.classList.add('theme-light');
            } else if (theme === 'neon') {
                document.body.classList.add('theme-neon');
            }
        }

        function filterGames(query) {
            const val = query.toLowerCase().trim();
            document.querySelectorAll('.game-card').forEach(card => {
                const titleNode = card.querySelector('h4');
                const title = titleNode ? titleNode.textContent.toLowerCase() : '';
                card.style.display = title.includes(val) ? 'block' : 'none';
            });
            renderCustomGames();
        }

        // -----------------------------------------------------------------
        // Custom JavaScript Game Studio
        // -----------------------------------------------------------------
        const CUSTOM_GAMES_KEY = 'arcadeHub.customGames.v1';

        function getCustomGames() {
            try {
                const saved = JSON.parse(localStorage.getItem(CUSTOM_GAMES_KEY) || '[]');
                return Array.isArray(saved) ? saved.filter(g =>
                    g && typeof g.name === 'string' && typeof g.code === 'string'
                ) : [];
            } catch (err) {
                console.warn('Could not read saved custom games:', err);
                return [];
            }
        }

        function setCustomGames(games) {
            try {
                localStorage.setItem(CUSTOM_GAMES_KEY, JSON.stringify(games.slice(0, 20)));
                return true;
            } catch (err) {
                alert('Your browser could not save this game. Try a smaller game or clear old custom games.');
                return false;
            }
        }

        function escapeHtml(value) {
            return String(value).replace(/[&<>"']/g, ch => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[ch]);
        }

        function renderCustomGames() {
            const list = document.getElementById('customGamesList');
            const empty = document.getElementById('customGamesEmpty');
            if (!list || !empty) return;

            const games = getCustomGames();
            list.innerHTML = '';

            empty.style.display = games.length ? 'none' : 'block';

            games.forEach((game, index) => {
                const card = document.createElement('div');
                card.className = 'panel-theme border rounded-xl p-4 flex flex-col justify-between';
                card.innerHTML = `
                    <div>
                        <div class="text-2xl mb-2">🧩</div>
                        <h4 class="font-extrabold text-base">${escapeHtml(game.name)}</h4>
                        <p class="text-xs text-gray-400 mt-1">Saved in this browser</p>
                    </div>
                    <div class="flex gap-2 mt-4">
                        <button class="flex-1 py-2 bg-cyan-600 hover:bg-cyan-700 rounded-lg text-xs font-bold">Play</button>
                        <button class="py-2 px-3 bg-gray-700 hover:bg-gray-600 rounded-lg text-xs font-bold">Edit</button>
                        <button class="py-2 px-3 bg-red-700 hover:bg-red-800 rounded-lg text-xs font-bold">Delete</button>
                    </div>
                `;
                const buttons = card.querySelectorAll('button');
                buttons[0].onclick = () => launchCustomGame(game.name, game.code);
                buttons[1].onclick = () => {
                    document.getElementById('customGameName').value = game.name;
                    document.getElementById('customGameCode').value = game.code;
                    showSection('games');
                    document.getElementById('customGameName').focus();
                };
                buttons[2].onclick = () => {
