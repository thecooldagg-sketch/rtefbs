@app.route("/")
def home():
    if "user_id" not in session:
        return redirect(url_for("login"))
    user = query_db("SELECT * FROM users WHERE id = ?", (session["user_id"],), one=True)
    return render_template_string(MAIN_INTERFACE, user=user)

@app.route("/login", methods=["GET", "POST"])
def login():
    if "user_id" in session:
        return redirect(url_for("home"))
    msg = ""
    if request.method == "POST":
        username = request.form.get("username", "").strip()
        password = request.form.get("password", "").strip()
        user = query_db("SELECT * FROM users WHERE username = ?", (username,), one=True)
        if user and check_password_hash(user["password_hash"], password):
            if user["is_banned"]:
                msg = "This account has been restricted."
            else:
                session["user_id"] = user["id"]
                session["username"] = user["username"]
                session["is_admin"] = bool(user["is_admin"])
                log_event(f"User {user['username']} logged in.")
                return redirect(url_for("home"))
        else:
            msg = "Invalid username or password credentials."
    return render_template_string(LOGIN_TEMPLATE, msg=msg)

@app.route("/register", methods=["GET", "POST"])
def register():
    if "user_id" in session:
        return redirect(url_for("home"))
    msg = ""
    if request.method == "POST":
        username = request.form.get("username", "").strip()
        password = request.form.get("password", "").strip()
        if len(username) < 3 or len(password) < 5:
            msg = "Username (min 3 chars) or Password (min 5 chars) too short."
        else:
            try:
                hashed = generate_password_hash(password)
                query_db("INSERT INTO users (username, password_hash) VALUES (?, ?)", (username, hashed))
                log_event(f"New registration: {username}")
                return redirect(url_for("login"))
            except sqlite3.IntegrityError:
                msg = "Username already taken."
    return render_template_string(REGISTER_TEMPLATE, msg=msg)

@app.route("/logout")
def logout():
    if "username" in session:
        log_event(f"User {session['username']} logged out.")
    session.clear()
    return redirect(url_for("login"))

