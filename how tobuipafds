            const reader = new FileReader();
            reader.onload = () => {
                const code = String(reader.result || '');
                document.getElementById('customGameCode').value =
                    file.name.toLowerCase().endsWith('.js')
                        ? '\\x3Cscript>\\n' + code + '\\n<' + '/script>'
                        : code;

