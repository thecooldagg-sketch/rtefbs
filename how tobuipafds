                if (!nameBox.value.trim()) {
                    nameBox.value = file.name.replace(/\\.(html?|js)$/i, '').slice(0, 40);
                }
            };
            reader.onerror = () => alert('Could not read that file.');
            reader.readAsText(file);
            input.value = '';
        }

