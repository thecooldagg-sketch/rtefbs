    return jsonify({
        "cpu": cpu_val,
        "ram": ram_val,
        "active_connections": len(lobby_active_users["slither"]) + len(lobby_active_users["agar"]) + len(lobby_active_users["paper"]) + len(lobby_active_users["arena"]),
        "logs": SERVER_LOGS[-15:]
    })

@app.route("/api/admin/toggle_maintenance", methods=["POST"])
def toggle_maintenance():
