# Start one game-loop thread when Gunicorn imports this module on Render.
# Keep one Gunicorn worker: multiplayer state is stored in process memory.
_game_loop_thread = None
_game_loop_lock = threading.Lock()

def start_background_game_loop():
    global _game_loop_thread
    with _game_loop_lock:
        if _game_loop_thread is None or not _game_loop_thread.is_alive():
            _game_loop_thread = threading.Thread(
                target=global_game_loop,
                name="ArcadeGameLoop",
                daemon=True
            )
            _game_loop_thread.start()

start_background_game_loop()

