@app.route("/api/rewards/add", methods=["POST"])
def save_single_reward():
    if "user_id" not in session:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json(silent=True) or {}
    try:
        xp_add = int(data.get("xp", 0))
        coins_add = int(data.get("coins", 0))
    except (TypeError, ValueError):
        return jsonify({"error": "Invalid reward values."}), 400

    # Browser-submitted values are untrusted.
    if xp_add < 0 or coins_add < 0 or xp_add > 500 or coins_add > 250:
        return jsonify({"error": "Reward amount out of bounds."}), 400

    user = query_db(
        "SELECT xp, coins FROM users WHERE id = ?",
        (session["user_id"],),
        one=True
    )
    if not user:
        return jsonify({"error": "User not found"}), 404

    new_xp = user["xp"] + xp_add
    new_coins = user["coins"] + coins_add
    query_db(
        "UPDATE users SET xp = ?, coins = ? WHERE id = ?",
        (new_xp, new_coins, session["user_id"])
    )
    return jsonify({"success": True, "xp": new_xp, "coins": new_coins})


