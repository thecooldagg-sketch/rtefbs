        // Tower Defense grid system
        function runTowerDefenseEngine() {
            let gold = 200, towers = [], creeps = [], wave = 1;
            const path = [{x: 50, y: 250}, {x: 250, y: 250}, {x: 250, y: 100}, {x: 550, y: 100}, {x: 550, y: 400}, {x: 750, y: 400}];

            activeGameMouseHandler = (e) => {
                if (activeGameType !== 'towerdefense') return;
                const rect = canvas.getBoundingClientRect();
                const scaleX = canvas.width / rect.width;
                const scaleY = canvas.height / rect.height;
                const mx = (e.clientX - rect.left) * scaleX;
                const my = (e.clientY - rect.top) * scaleY;

                if (gold >= 100) {
                    towers.push({ x: mx, y: my, r: 80, dmg: 4 });
                    gold -= 100;
                    Sound.play('hit');
                }
            };
            canvas.addEventListener('mousedown', activeGameMouseHandler);

            viewportLoop = setInterval(() => {
                ctx.fillStyle = '#0f172a';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Draw Track path lines
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
                ctx.lineWidth = 32;
                ctx.beginPath();
                path.forEach((pt, i) => {
                    if (i === 0) ctx.moveTo(pt.x, pt.y);
                    else ctx.lineTo(pt.x, pt.y);
                });
                ctx.stroke();

                // Spawn creeps
                if (creeps.length === 0) {
                    for (let i = 0; i < 5 + wave; i++) {
                        creeps.push({ x: 50, y: 250, hp: 50 + wave*20, idx: 0, speed: 2 });
                    }
                    wave++;
                }

                // Tick creeps
                creeps.forEach(c => {
                    const target = path[c.idx + 1];
                    if (target) {
                        const dx = target.x - c.x;
                        const dy = target.y - c.y;
                        const dist = Math.hypot(dx, dy);
                        if (dist < 4) {
                            c.idx++;
                        } else {
                            c.x += (dx / dist) * c.speed;
                            c.y += (dy / dist) * c.speed;
                        }
                    }

                    // Render creep
                    ctx.fillStyle = '#22c55e';
                    ctx.beginPath(); ctx.arc(c.x, c.y, 10, 0, Math.PI*2); ctx.fill();
                });

                // Tower attacks and tracking
                towers.forEach(t => {
                    ctx.fillStyle = '#3b82f6';
                    ctx.beginPath(); ctx.arc(t.x, t.y, 14, 0, Math.PI*2); ctx.fill();

                    // Search targets
                    creeps.forEach(c => {
                        if (Math.hypot(c.x - t.x, c.y - t.y) < t.r) {
                            c.hp -= t.dmg;
                            // draw fire traces
                            ctx.strokeStyle = '#ef4444'; ctx.lineWidth = 1.5;
                            ctx.beginPath(); ctx.moveTo(t.x, t.y); ctx.lineTo(c.x, c.y); ctx.stroke();
                        }
                    });
                });

                // Remove dead creeps
                creeps = creeps.filter(c => {
                    if (c.hp <= 0) {
                        gold += 15;
                        awardStats(5, 10);
                        return false;
                    }
                    return c.idx < path.length - 1;
                });

                // Status indicators
                ctx.fillStyle = 'white';
                ctx.font = 'bold 14px sans-serif';
                ctx.fillText(`Gold: ${gold} | Active Wave: ${wave}`, 20, 30);
            }, 60);
        }

