@socketio.on("join_lobby")
def on_join_lobby(data):
    room = data.get("room")
    if room in lobby_active_users:
        join_room(room)
        lobby_active_users[room].add(request.sid)
        
        # Spawn user in room
        username = session.get("username", f"Player_{random.randint(100,999)}")
        with state_lock:
            if room == "slither":
                multiplayer_states["slither"]["players"][request.sid] = make_slither_player(request.sid, username)
            elif room == "agar":
                multiplayer_states["agar"]["players"][request.sid] = make_agar_player(request.sid, username)
            elif room == "paper":
                multiplayer_states["paper"]["players"][request.sid] = make_territory_player(request.sid, username)
            elif room == "arena":
                # Multi-type Top-Down Handler
                multiplayer_states["arena"]["players"][request.sid] = {
                    "id": request.sid, "name": username, "bot": False,
                    "x": random.randint(100, multiplayer_states["arena"]["w"]-100),
                    "y": random.randint(100, multiplayer_states["arena"]["h"]-100),
                    "health": 100, "team": "red" if random.random() < 0.5 else "blue", "score": 0, "color": "#3b82f6"
                }

@socketio.on("leave_lobby")
def on_leave_lobby(data):
    room = data.get("room")
    if room in lobby_active_users:
        leave_room(room)
        lobby_active_users[room].discard(request.sid)
        with state_lock:
            multiplayer_states[room]["players"].pop(request.sid, None)

@socketio.on("disconnect")
def on_disconnect():
    for room in lobby_active_users:
        lobby_active_users[room].discard(request.sid)
        with state_lock:
            multiplayer_states[room]["players"].pop(request.sid, None)

# Sockets Input Coordinates Control
@socketio.on("slither_input")
def slither_input(data):
    with state_lock:
        p = multiplayer_states["slither"]["players"].get(request.sid)
        if p:
            p["turn_target"] = data.get("angle", p["turn_target"])
            p["boost"] = bool(data.get("boost", False))

@socketio.on("agar_input")
def agar_input(data):
    with state_lock:
        p = multiplayer_states["agar"]["players"].get(request.sid)
        if p:
            p["turn_target_x"] = data.get("x", p["turn_target_x"])
            p["turn_target_y"] = data.get("y", p["turn_target_y"])

@socketio.on("paper_input")
def paper_input(data):
    with state_lock:
        p = multiplayer_states["paper"]["players"].get(request.sid)
        if p:
            dx, dy = data.get("dx", 0), data.get("dy", 0)
            if (dx != 0 and p["dx"] == 0) or (dy != 0 and p["dy"] == 0):
                p["dx"], p["dy"] = dx, dy

@socketio.on("arena_input")
def arena_input(data):
    with state_lock:
        p = multiplayer_states["arena"]["players"].get(request.sid)
        if p:
            p["x"] = max(20, min(multiplayer_states["arena"]["w"] - 20, p["x"] + data.get("dx", 0) * 5))
            p["y"] = max(20, min(multiplayer_states["arena"]["h"] - 20, p["y"] + data.get("dy", 0) * 5))

@socketio.on("arena_shoot")
def arena_shoot(data):
    with state_lock:
        state = multiplayer_states["arena"]
        p = state["players"].get(request.sid)
        if p:
            tx, ty = data.get("x", 0), data.get("y", 0)
            angle = math.atan2(ty - p["y"], tx - p["x"])
            state["bullets"].append({
                "owner": request.sid, "x": p["x"], "y": p["y"],
                "dx": math.cos(angle), "dy": math.sin(angle)
            })

