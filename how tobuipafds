@app.route("/api/telemetry")
def get_telemetry():
    if not session.get("is_admin", False):
        return jsonify({"error": "Unauthorized"}), 401
    
    # Real metrics fallback to simulation
    cpu_val = random.randint(12, 35)
    ram_val = random.randint(40, 62)
    if psutil:
        try:
