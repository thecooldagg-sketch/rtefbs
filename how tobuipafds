@app.route("/api/profile/daily", methods=["POST"])
def claim_daily():
    if "user_id" not in session:
         return jsonify({"error": "Unauthorized"}), 401
    user = query_db("SELECT last_daily, coins FROM users WHERE id = ?", (session["user_id"],), one=True)
    now = int(time.time())
    # 24 Hours check
    if now - user["last_daily"] >= 86400:
        new_coins = user["coins"] + 50
        query_db("UPDATE users SET coins = ?, last_daily = ? WHERE id = ?", (new_coins, now, session["user_id"]))
        return jsonify({"success": True, "coins": new_coins, "msg": "Acquired daily reward of 50 coins!"})
    return jsonify({"success": False, "msg": "Reward unavailable. Check back in later."})

@app.route("/api/shop/purchase", methods=["POST"])
def shop_purchase():
    if "user_id" not in session:
        return jsonify({"error": "Unauthorized"}), 401

    data = request.get_json(silent=True) or {}
    skin = str(data.get("skin", "")).strip()

    # Never trust a price supplied by the browser.
    SHOP_PRICES = {
        "cyber_laser": 150,
        "quantum_blue": 200,
    }
    cost = SHOP_PRICES.get(skin)
    if cost is None:
        return jsonify({"success": False, "msg": "Unknown shop item."}), 400

    user = query_db(
        "SELECT coins, unlocked_skins FROM users WHERE id = ?",
        (session["user_id"],),
        one=True
    )
    if not user:
        return jsonify({"error": "User not found"}), 404

    try:
        unlocked = json.loads(user["unlocked_skins"] or "[]")
        if not isinstance(unlocked, list):
            unlocked = []
    except (TypeError, json.JSONDecodeError):
        unlocked = []

    if skin in unlocked:
        return jsonify({"success": False, "msg": "Skin already acquired."})

    if user["coins"] < cost:
        return jsonify({"success": False, "msg": "Insufficient funds."})

    unlocked.append(skin)
    new_coins = user["coins"] - cost
    query_db(
        "UPDATE users SET coins = ?, unlocked_skins = ? WHERE id = ?",
        (new_coins, json.dumps(unlocked), session["user_id"])
    )
    return jsonify({"success": True, "coins": new_coins})


