DB_FILE = "arcade.db"

def init_db():
    with sqlite3.connect(DB_FILE) as conn:
        cursor = conn.cursor()
        cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            xp INTEGER DEFAULT 0,
            coins INTEGER DEFAULT 100,
            avatar TEXT DEFAULT 'default_char',
            is_admin INTEGER DEFAULT 0,
            is_banned INTEGER DEFAULT 0,
            unlocked_skins TEXT DEFAULT '["classic"]',
            active_skin TEXT DEFAULT 'classic',
            achievements TEXT DEFAULT '[]',
            high_scores TEXT DEFAULT '{}',
            friends TEXT DEFAULT '[]',
            last_daily INTEGER DEFAULT 0
        )
        """)
        # Create default admin if not exists
        cursor.execute("SELECT id FROM users WHERE username = 'admin'")
        if not cursor.fetchone():
            cursor.execute(
                "INSERT INTO users (username, password_hash, is_admin) VALUES (?, ?, ?)",
                ("admin", generate_password_hash("admin123"), 1)
            )
        conn.commit()

init_db()

def query_db(query, args=(), one=False):
    with sqlite3.connect(DB_FILE) as conn:
        conn.row_factory = sqlite3.Row
        cur = conn.cursor()
        cur.execute(query, args)
        rv = cur.fetchall()
        conn.commit()
        return (rv[0] if rv else None) if one else rv

# -------------------------------------------------------------------------
# Security Utilities & State
# -------------------------------------------------------------------------
REQUEST_LOG = defaultdict(deque)
RATE_LIMIT_WINDOW = 10  # Seconds
RATE_LIMIT_MAX = 80     # Max requests per window

MAINTENANCE_MODE = False
SERVER_LOGS = []

def log_event(message):
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    SERVER_LOGS.append(f"[{timestamp}] {message}")
    if len(SERVER_LOGS) > 100:
        SERVER_LOGS.pop(0)

def get_client_ip():
    # Only trust the direct peer by default. X-Forwarded-For is spoofable
    # unless this app is behind a configured/trusted reverse proxy.
    return (request.remote_addr or "unknown").strip()

@app.before_request
def security_and_maintenance():
    ip = get_client_ip()
    now = time.time()
    
    # Rate Limiting
    q = REQUEST_LOG[ip]
    while q and now - q[0] > RATE_LIMIT_WINDOW:
        q.popleft()
    if len(q) >= RATE_LIMIT_MAX:
        return "Aggressive requests detected. Please slow down.", 429
    q.append(now)

    # Active Ban check
    if "user_id" in session:
        user = query_db("SELECT is_banned, is_admin FROM users WHERE id = ?", (session["user_id"],), one=True)
        if user:
            if user["is_banned"]:
                session.clear()
                return "Your account has been restricted by an administrator.", 403
            session["is_admin"] = bool(user["is_admin"])
        else:
            session.clear()

    # Maintenance mode bypass logic
    if MAINTENANCE_MODE and not session.get("is_admin", False):
        if request.endpoint not in ["login", "static", "logout"]:
            return """
            <body style="background:#0f172a;color:#cbd5e1;font-family:sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;flex-direction:column;">
                <h1 style="color:#ef4444;font-size:2.5rem;margin-bottom:8px;">System Maintenance</h1>
                <p style="font-size:1.1rem;margin:0;">Arcade Hub is undergoing scheduled server updates. Please check back shortly.</p>
            </body>
            """, 503

@app.after_request
def apply_defensive_headers(resp):
    resp.headers["X-Content-Type-Options"] = "nosniff"
    resp.headers["X-Frame-Options"] = "SAMEORIGIN"
    resp.headers["Referrer-Policy"] = "strict-origin-when-cross-origin"
    resp.headers["Content-Security-Policy"] = (
        "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https://cdn.jsdelivr.net https://cdn.socket.io;"
        "img-src 'self' data: blob:;"
        "style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net;"
        "connect-src 'self' ws: wss:;"
        "frame-src 'self' blob: data:;"
    )
    return resp

