# Slither helper state
def spawn_slither_food(state, count=1):
    for _ in range(count):
        state["foods"].append({
            "id": random.randint(0, 1000000),
            "x": random.randint(20, state["w"] - 20),
            "y": random.randint(20, state["h"] - 20),
            "val": random.randint(1, 3),
            "color": "#{:06x}".format(random.randint(0x333333, 0xFFFFFF))
        })

def make_slither_player(sid, name, bot=False):
    w, h = multiplayer_states["slither"]["w"], multiplayer_states["slither"]["h"]
    x, y = random.randint(200, w - 200), random.randint(200, h - 200)
    angle = random.random() * 6.28
    return {
        "id": sid, "name": name, "bot": bot, "x": x, "y": y, "angle": angle, "speed": 4.0, "radius": 15,
        "body": [{"x": x - i * 10, "y": y} for i in range(12)], "alive": True, "score": 0, "color": "#{:06x}".format(random.randint(0, 0xFFFFFF)),
        "boost": False, "turn_target": angle
    }

def update_slither():
    state = multiplayer_states["slither"]
    now = time.time()
    dt = min(0.05, now - state["last_tick"])
    state["last_tick"] = now

    # Ensure Bots
    while len(state["bots"]) < 10:
        bot_id = f"bot_{random.randint(1000, 9999)}"
        state["bots"].append(make_slither_player(bot_id, f"SnakeBot_{random.randint(1, 99)}", bot=True))

    # Spawn foods
    if len(state["foods"]) < 120:
        spawn_slither_food(state, 120 - len(state["foods"]))

    all_entities = list(state["players"].values()) + state["bots"]

    # Tick bots
    for b in state["bots"]:
        if not b["alive"]:
            state["bots"].remove(b)
            continue
        # Bot movement - chase closest food
        closest_f, min_d = None, 99999
        for f in state["foods"]:
            d = math.hypot(f["x"] - b["x"], f["y"] - b["y"])
            if d < min_d:
                min_d = d
                closest_f = f
        if closest_f:
            b["turn_target"] = math.atan2(closest_f["y"] - b["y"], closest_f["x"] - b["x"])
        
        # Linear Interpolation (LERP) movement direction
        diff = (b["turn_target"] - b["angle"] + math.pi) % (2 * math.pi) - math.pi
        b["angle"] += diff * 0.12
        spd = b["speed"]
        b["x"] = (b["x"] + math.cos(b["angle"]) * spd) % state["w"]
        b["y"] = (b["y"] + math.sin(b["angle"]) * spd) % state["h"]
        
        b["body"].insert(0, {"x": b["x"], "y": b["y"]})
        if len(b["body"]) > 12 + b["score"]:
            b["body"].pop()

    # Tick humans
    for p in state["players"].values():
        if not p["alive"]:
            continue
        diff = (p["turn_target"] - p["angle"] + math.pi) % (2 * math.pi) - math.pi
        p["angle"] += diff * 0.15
        spd = p["speed"] * (1.6 if p["boost"] else 1.0)
        p["x"] = (p["x"] + math.cos(p["angle"]) * spd) % state["w"]
        p["y"] = (p["y"] + math.sin(p["angle"]) * spd) % state["h"]
        
        p["body"].insert(0, {"x": p["x"], "y": p["y"]})
        if len(p["body"]) > 12 + p["score"]:
            p["body"].pop()

    # Check Eating & Collision
    for ent in all_entities:
        if not ent["alive"]:
            continue
        # Eat food
        for f in state["foods"][:]:
            if math.hypot(f["x"] - ent["x"], f["y"] - ent["y"]) < ent["radius"] + 8:
                ent["score"] += f["val"]
                state["foods"].remove(f)
        
        # Self/Other Collisions
        for other in all_entities:
            if other["id"] == ent["id"] or not other["alive"]:
                continue
            # Collide with other's body segments
            for seg in other["body"][4:]:
                if math.hypot(seg["x"] - ent["x"], seg["y"] - ent["y"]) < ent["radius"] + 5:
                    ent["alive"] = False
                    # convert body segments to food drops
                    for b_seg in ent["body"][::3]:
                        state["foods"].append({
                            "id": random.randint(0, 1000000),
                            "x": b_seg["x"], "y": b_seg["y"], "val": 4, "color": ent["color"]
                        })
                    break

# Agar helper state
def make_agar_player(sid, name, bot=False):
    w, h = multiplayer_states["agar"]["w"], multiplayer_states["agar"]["h"]
    return {
        "id": sid, "name": name, "bot": bot, "x": random.randint(100, w-100), "y": random.randint(100, h-100),
        "mass": 30.0, "color": "#{:06x}".format(random.randint(0, 0xFFFFFF)), "alive": True, "turn_target_x": 0, "turn_target_y": 0
    }

def update_agar():
    state = multiplayer_states["agar"]
    # Spawn food
    while len(state["foods"]) < 150:
        state["foods"].append({
            "id": random.randint(0, 1000000),
            "x": random.randint(20, state["w"] - 20),
            "y": random.randint(20, state["h"] - 20),
            "color": "#{:06x}".format(random.randint(0, 0xFFFFFF))
        })
    # Spawn Bots
    while len(state["bots"]) < 8:
        bot_id = f"bot_{random.randint(1000, 9999)}"
        state["bots"].append(make_agar_player(bot_id, f"CellBot_{random.randint(1, 99)}", bot=True))

    all_entities = list(state["players"].values()) + state["bots"]

    # Move elements
    for ent in all_entities:
        if not ent["alive"]:
            continue
        rad = math.sqrt(ent["mass"]) * 4
        spd = max(1.5, 8.0 - (rad * 0.05)) # Slow down based on mass

        if ent["bot"]:
            # Bot tracks food
            closest_f, min_d = None, 99999
            for f in state["foods"]:
                d = math.hypot(f["x"] - ent["x"], f["y"] - ent["y"])
                if d < min_d:
                    min_d = d
                    closest_f = f
            if closest_f:
                ent["turn_target_x"], ent["turn_target_y"] = closest_f["x"], closest_f["y"]

        # Vector trajectory
        dx = ent["turn_target_x"] - ent["x"]
        dy = ent["turn_target_y"] - ent["y"]
        dist = math.hypot(dx, dy)
        if dist > 5:
            ent["x"] = max(rad, min(state["w"] - rad, ent["x"] + (dx / dist) * spd))
            ent["y"] = max(rad, min(state["h"] - rad, ent["y"] + (dy / dist) * spd))

        # Check eating foods
        for f in state["foods"][:]:
            if math.hypot(f["x"] - ent["x"], f["y"] - ent["y"]) < rad + 4:
                ent["mass"] += 1.5
                state["foods"].remove(f)

    # Player-on-player collisions
    for ent in all_entities:
        if not ent["alive"]:
            continue
        rad = math.sqrt(ent["mass"]) * 4
        for other in all_entities:
            if other["id"] == ent["id"] or not other["alive"]:
                continue
            other_rad = math.sqrt(other["mass"]) * 4
            d = math.hypot(other["x"] - ent["x"], other["y"] - ent["y"])
            # Require 20% mass difference to consume
            if d < rad - other_rad * 0.4:
                if ent["mass"] > other["mass"] * 1.2:
                    ent["mass"] += other["mass"]
                    other["alive"] = False
                    if other in state["bots"]:
                        state["bots"].remove(other)

# Territory/Paper helper state
def make_territory_player(sid, name, bot=False):
    w, h, cell = multiplayer_states["paper"]["w"], multiplayer_states["paper"]["h"], multiplayer_states["paper"]["cell"]
    cols, rows = w // cell, h // cell
    px, py = random.randint(4, cols - 5), random.randint(4, rows - 5)
    owned = []
    # Starting square
    for dy in range(-2, 3):
        for dx in range(-2, 3):
            owned.append(f"{px+dx},{py+dy}")
    return {
        "id": sid, "name": name, "bot": bot, "x": px, "y": py, "dx": 1, "dy": 0, "color": "#{:06x}".format(random.randint(0, 0xFFFFFF)),
        "owned": owned, "trail": [], "alive": True, "score": len(owned)
    }

def update_paper():
    state = multiplayer_states["paper"]
    cell = state["cell"]
    cols, rows = state["w"] // cell, state["h"] // cell

    # Handle Bots
    while len(state["bots"]) < 6:
        bot_id = f"bot_{random.randint(1000, 9999)}"
        state["bots"].append(make_territory_player(bot_id, f"PaperBot_{random.randint(1, 99)}", bot=True))

    all_entities = list(state["players"].values()) + state["bots"]

    for ent in all_entities:
        if not ent["alive"]:
            continue
        
        # Bot direction
        if ent["bot"]:
            if random.random() < 0.08:
                choices = [(1,0), (-1,0), (0,1), (0,-1)]
                # avoid moving directly backward
                choices = [c for c in choices if c[0] != -ent["dx"] or c[1] != -ent["dy"]]
                if choices:
                    ent["dx"], ent["dy"] = random.choice(choices)

        nx = ent["x"] + ent["dx"]
        ny = ent["y"] + ent["dy"]

        # Clamp inside boundaries
        if nx < 0 or nx >= cols or ny < 0 or ny >= rows:
            ent["alive"] = False
            continue

        ent["x"], ent["y"] = nx, ny
        pos_str = f"{nx},{ny}"

        if pos_str in ent["owned"]:
            # Reconnected back into own territory
            if ent["trail"]:
                # Claim mechanics
                for t_pos in ent["trail"]:
                    if t_pos not in ent["owned"]:
                        ent["owned"].append(t_pos)
                ent["trail"].clear()
                ent["score"] = len(ent["owned"])
        else:
            # Traveling outside own territory
            if pos_str in ent["trail"]:
                # Ran into own trail
                ent["alive"] = False
                continue
            ent["trail"].append(pos_str)

        # Check trailing collision with others
        for other in all_entities:
            if other["id"] == ent["id"] or not other["alive"]:
                continue
            if pos_str in other["trail"]:
                other["alive"] = False
                other["trail"].clear()
                # claim some extra land
                ent["score"] += 15

# Arena multiplayer handler
def update_arena():
    state = multiplayer_states["arena"]
    # Handle Bots
    while len(state["bots"]) < 5:
        bot_id = f"bot_{random.randint(1000, 9999)}"
        state["bots"].append({
            "id": bot_id, "name": f"ArenaBot_{random.randint(1, 99)}", "bot": True,
            "x": random.randint(100, state["w"]-100), "y": random.randint(100, state["h"]-100),
            "health": 100, "team": "red" if random.random() < 0.5 else "blue", "score": 0, "color": "#ef4444"
        })

    # Zombie Mode management
    if state["mode"] == "survival":
        while len(state["zombies"]) < 12:
            state["zombies"].append({
                "id": random.randint(0, 1000000),
                "x": random.choice([0, state["w"]]), "y": random.choice([0, state["h"]]),
                "health": 40, "speed": 2.5, "target": None
            })

    # Move bullets
    for b in state["bullets"][:]:
        b["x"] += b["dx"] * 14
        b["y"] += b["dy"] * 14
        if b["x"] < 0 or b["x"] > state["w"] or b["y"] < 0 or b["y"] > state["h"]:
            state["bullets"].remove(b)
            continue
        
        # Check hitting players
        all_p = list(state["players"].values()) + state["bots"]
        hit_detected = False
        for p in all_p:
            if p["id"] == b["owner"]:
                continue
            if math.hypot(p["x"] - b["x"], p["y"] - b["y"]) < 25:
                p["health"] -= 15
                hit_detected = True
                if p["health"] <= 0:
                    # Grant points
                    p["health"] = 100
                    p["x"], p["y"] = random.randint(100, state["w"]-100), random.randint(100, state["h"]-100)
                    owner_p = next((x for x in all_p if x["id"] == b["owner"]), None)
                    if owner_p:
                        owner_p["score"] += 10
                break
        
        # Check hitting zombies
        if not hit_detected and state["mode"] == "survival":
            for z in state["zombies"][:]:
                if math.hypot(z["x"] - b["x"], z["y"] - b["y"]) < 20:
                    z["health"] -= 20
                    hit_detected = True
                    if z["health"] <= 0:
                        state["zombies"].remove(z)
                        owner_p = next((x for x in all_p if x["id"] == b["owner"]), None)
                        if owner_p:
                            owner_p["score"] += 5
                    break

        if hit_detected:
            state["bullets"].remove(b)

    # Zombie Chase Logic
    if state["mode"] == "survival":
        all_human = list(state["players"].values())
        for z in state["zombies"]:
            if all_human:
                closest_h = min(all_human, key=lambda h: math.hypot(h["x"] - z["x"], h["y"] - z["y"]))
                z["target"] = closest_h["id"]
                dx = closest_h["x"] - z["x"]
                dy = closest_h["y"] - z["y"]
                dist = math.hypot(dx, dy)
                if dist > 5:
                    z["x"] += (dx / dist) * z["speed"]
                    z["y"] += (dy / dist) * z["speed"]
                
                # Deal damage to player
                if dist < 22:
                    closest_h["health"] -= 0.5
                    if closest_h["health"] <= 0:
                        closest_h["health"] = 100
                        closest_h["x"], closest_h["y"] = random.randint(100, state["w"]-100), random.randint(100, state["h"]-100)

    # Bot behaviors (simple roaming / shooting)
    all_human = list(state["players"].values())
    for bot in state["bots"]:
        if all_human:
            closest_h = min(all_human, key=lambda h: math.hypot(h["x"] - bot["x"], h["y"] - bot["y"]))
            dx = closest_h["x"] - bot["x"]
            dy = closest_h["y"] - bot["y"]
            dist = math.hypot(dx, dy)
            if dist > 150:
                bot["x"] += (dx / dist) * 3
                bot["y"] += (dy / dist) * 3
            elif random.random() < 0.05:
                # Shoot toward closest human
                angle = math.atan2(dy, dx)
                state["bullets"].append({
                    "owner": bot["id"], "x": bot["x"], "y": bot["y"],
                    "dx": math.cos(angle), "dy": math.sin(angle)
                })

# Main background loop
def global_game_loop():
    while True:
        with state_lock:
            # Tick Slither if users present
            if lobby_active_users["slither"]:
                update_slither()
                socketio.emit("slither_tick", multiplayer_states["slither"], room="slither")

            # Tick Agar
            if lobby_active_users["agar"]:
                update_agar()
                socketio.emit("agar_tick", multiplayer_states["agar"], room="agar")

            # Tick Paper
            if lobby_active_users["paper"]:
                update_paper()
                socketio.emit("paper_tick", multiplayer_states["paper"], room="paper")

            # Tick Arena
            if lobby_active_users["arena"]:
                update_arena()
                socketio.emit("arena_tick", multiplayer_states["arena"], room="arena")

        socketio.sleep(0.05) # ~20 Tick Rate

