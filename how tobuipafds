        function handleMouseCoordInput(e) {
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            const mx = (e.clientX - rect.left) * scaleX;
            const my = (e.clientY - rect.top) * scaleY;

            if (activeGameType === 'slither') {
                // calculate angle relative to snake center positions (simulate simple client vectors)
                const angle = Math.atan2(my - canvas.height/2, mx - canvas.width/2);
                socket.emit("slither_input", { angle, boost: activeKeys[' '] });
            } else if (activeGameType === 'agar') {
                socket.emit("agar_input", { x: mx * 2.5, y: my * 2.5 });
            }
        }

        // -----------------------------------------------------------------
        // MULTIPLAYER CLIENT GRAPHICS SYSTEM
        // -----------------------------------------------------------------
        let multiData = null;
        function launchMultiplayerGame(lobby) {
            canvas.style.display = 'block';
            canvas.width = 1200;
            canvas.height = 700;

            const room_map = {
                'slither': 'slither', 'agar': 'agar', 'paper': 'paper',
                'arena_ffa': 'arena', 'arena_zombie': 'arena', 'arena_paintball': 'arena', 'arena_ctf': 'arena'
            };
            const activeRoom = room_map[lobby];
            socket.emit("join_lobby", { room: activeRoom });

            // Subscribe to exactly one tick handler for this active game.
            activeSocketTickEvent = `${activeRoom}_tick`;
            activeSocketTickHandler = (state) => {
                multiData = state;
            };
            socket.on(activeSocketTickEvent, activeSocketTickHandler);

            window.addEventListener('keydown', handleKeyInput);
            window.addEventListener('keyup', handleKeyRelease);
            canvas.addEventListener('mousemove', handleMouseCoordInput);

            viewportLoop = setInterval(() => {
                if (!multiData) return;
                ctx.fillStyle = '#090d16';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                // Grid background drawing
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
                ctx.lineWidth = 1;
                for (let x = 0; x < canvas.width; x += 40) {
                    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
                }
                for (let y = 0; y < canvas.height; y += 40) {
                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
                }

                if (lobby === 'slither') {
                    // Draw Food drops
                    multiData.foods.forEach(f => {
                        ctx.fillStyle = f.color;
                        ctx.beginPath();
                        ctx.arc(f.x * (canvas.width/multiData.w), f.y * (canvas.height/multiData.h), 4 + f.val, 0, Math.PI*2);
                        ctx.fill();
                    });
                    // Draw Snakes
                    const snakes = Object.values(multiData.players).concat(multiData.bots);
                    snakes.forEach(s => {
                        if (!s.alive) return;
                        ctx.strokeStyle = s.color;
                        ctx.lineWidth = s.radius;
                        ctx.lineCap = 'round';
                        ctx.lineJoin = 'round';
                        ctx.beginPath();
                        s.body.forEach((seg, idx) => {
                            const cx = seg.x * (canvas.width/multiData.w);
                            const cy = seg.y * (canvas.height/multiData.h);
                            if (idx === 0) ctx.moveTo(cx, cy);
                            else ctx.lineTo(cx, cy);
                        });
                        ctx.stroke();

                        // Eye dots on head
                        ctx.fillStyle = 'white';
                        const headX = s.x * (canvas.width/multiData.w);
                        const headY = s.y * (canvas.height/multiData.h);
                        ctx.beginPath();
                        ctx.arc(headX, headY, 4, 0, Math.PI*2);
                        ctx.fill();

                        ctx.fillStyle = 'rgba(255,255,255,0.7)';
                        ctx.font = '11px sans-serif';
                        ctx.fillText(s.name, headX - 15, headY - 15);
                    });
                }
                else if (lobby === 'agar') {
                    // Draw Food Particles
                    multiData.foods.forEach(f => {
                        ctx.fillStyle = f.color;
                        ctx.beginPath();
                        ctx.arc(f.x * (canvas.width/multiData.w), f.y * (canvas.height/multiData.h), 4, 0, Math.PI*2);
                        ctx.fill();
                    });
                    // Draw Cells
                    const cells = Object.values(multiData.players).concat(multiData.bots);
                    cells.forEach(c => {
                        if (!c.alive) return;
                        const rad = Math.sqrt(c.mass) * 3;
                        const cx = c.x * (canvas.width/multiData.w);
                        const cy = c.y * (canvas.height/multiData.h);
                        
                        ctx.fillStyle = c.color;
                        ctx.beginPath();
                        ctx.arc(cx, cy, rad, 0, Math.PI*2);
                        ctx.fill();
                        ctx.strokeStyle = 'white';
                        ctx.lineWidth = 1.5;
                        ctx.stroke();

                        ctx.fillStyle = 'white';
                        ctx.font = 'bold 11px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText(c.name, cx, cy + 4);
                    });
                }
                else if (lobby === 'paper') {
                    // Draw paper territory
                    const players = Object.values(multiData.players).concat(multiData.bots);
                    const cell = canvas.width / (multiData.w / multiData.cell);
                    
                    players.forEach(p => {
                        if (!p.alive) return;
                        // Owned land cells
                        ctx.fillStyle = p.color + "33";
                        p.owned.forEach(pos => {
                            const [px, py] = pos.split(',').map(Number);
                            ctx.fillRect(px * cell, py * cell, cell, cell);
                        });
                        // Current trail cells
                        ctx.fillStyle = p.color + "99";
                        p.trail.forEach(pos => {
                            const [px, py] = pos.split(',').map(Number);
                            ctx.fillRect(px * cell + 2, py * cell + 2, cell - 4, cell - 4);
                        });
                        // Head block
                        ctx.fillStyle = p.color;
                        ctx.fillRect(p.x * cell, p.y * cell, cell, cell);
                    });
                }
                else if (lobby.startsWith('arena')) {
                    // Top-Down shooter render loop
                    const players = Object.values(multiData.players).concat(multiData.bots);
                    
                    // Simple input trigger emit
                    let dx = 0, dy = 0;
                    if (activeKeys['ArrowUp'] || activeKeys['w']) dy = -1;
                    if (activeKeys['ArrowDown'] || activeKeys['s']) dy = 1;
                    if (activeKeys['ArrowLeft'] || activeKeys['a']) dx = -1;
                    if (activeKeys['ArrowRight'] || activeKeys['d']) dx = 1;
                    if (dx !== 0 || dy !== 0) socket.emit("arena_input", { dx, dy });

                    // Projectiles
                    multiData.bullets.forEach(b => {
                        ctx.fillStyle = '#facc15';
                        ctx.beginPath();
                        ctx.arc(b.x * (canvas.width/multiData.w), b.y * (canvas.height/multiData.h), 4, 0, Math.PI*2);
                        ctx.fill();
                    });

                    // Target Zombies
                    multiData.zombies.forEach(z => {
                        const zx = z.x * (canvas.width/multiData.w);
                        const zy = z.y * (canvas.height/multiData.h);
                        ctx.fillStyle = '#22c55e';
                        ctx.beginPath(); ctx.arc(zx, zy, 12, 0, Math.PI*2); ctx.fill();
                        
                        // Health Bar
                        ctx.fillStyle = '#ef4444';
                        ctx.fillRect(zx - 15, zy - 20, 30, 4);
                        ctx.fillStyle = '#22c55e';
                        ctx.fillRect(zx - 15, zy - 20, (z.health/40)*30, 4);
                    });

                    // Draw Players
                    players.forEach(p => {
                        const px = p.x * (canvas.width/multiData.w);
                        const py = p.y * (canvas.height/multiData.h);
                        ctx.fillStyle = p.team === 'red' ? '#ef4444' : '#3b82f6';
                        ctx.beginPath(); ctx.arc(px, py, 14, 0, Math.PI*2); ctx.fill();

                        // Health Bar
                        ctx.fillStyle = '#ef4444';
                        ctx.fillRect(px - 15, py - 22, 30, 4);
                        ctx.fillStyle = '#10b981';
                        ctx.fillRect(px - 15, py - 22, (p.health/100)*30, 4);

                        ctx.fillStyle = 'white';
                        ctx.font = '10px sans-serif';
                        ctx.textAlign = 'center';
                        ctx.fillText(`${p.name} (${p.score})`, px, py + 26);
                    });
                }
            }, 50);

            // Click listener to shoot in Arena Modes.
            if (lobby.startsWith('arena')) {
                activeGameMouseHandler = (e) => {
                    const rect = canvas.getBoundingClientRect();
                    const scaleX = canvas.width / rect.width;
                    const scaleY = canvas.height / rect.height;
                    const mx = (e.clientX - rect.left) * scaleX;
                    const my = (e.clientY - rect.top) * scaleY;
                    const worldX = mx * (1800 / canvas.width);
                    const worldY = my * (1200 / canvas.height);
                    socket.emit("arena_shoot", { x: worldX, y: worldY });
                    Sound.play('laser');
                };
                canvas.addEventListener('mousedown', activeGameMouseHandler);
            }
        }

